---
import Base from '../layouts/Base.astro';
import { getProjects, getPosts, getSite, formatDate, isoDate } from '../lib/content';

const site = getSite();
const projects = (await getProjects()).slice(0, 4);
const posts = (await getPosts()).slice(0, 3);
---

<Base title={site.name} description={site.description}>
  <script slot="head" is:inline>document.documentElement.classList.add('js')</script>
  <script slot="head" type="importmap" is:inline>
    {
      "imports": {
        "three": "/scene/vendor/three/three.module.js",
        "three/addons/": "/scene/vendor/three/addons/"
      }
    }
  </script>
  <!-- The room's first load (2026-11-13). Only with ?room&glb, and not when boot.js will refuse the room (reduced
       motion without room=force, no WebGL2): start every download the room needs right now, in parallel, instead
       of finding each one a step at a time (boot.js -> content.json -> desktop.js -> three -> room.glb -> draco).
       The module list is desktop.js's import graph; a file missing from it just loads later. The light files'
       names are in room-light.json; the Draco decoder's in desktop.js (DRACO_DECODER). Bloom's modules are only
       listed where desktop.js turns bloom on (BLOOM.minWidth, not a coarse pointer). docs/02-architecture.md. -->
  <script slot="head" is:inline>
    (function () {
      var q = new URLSearchParams(location.search);
      if (!q.has('room') || !q.has('glb') || typeof WebGL2RenderingContext === 'undefined') return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches && q.get('room') !== 'force') return;
      var head = document.head;
      function add(rel, href, as, cross) {
        var l = document.createElement('link');
        l.rel = rel; l.href = href;
        if (as) l.as = as;
        if (cross) l.crossOrigin = 'anonymous';
        head.appendChild(l);
      }
      var S = '/scene/', V = S + 'vendor/three/', A = V + 'addons/';
      var code = [S + 'boot.js', S + 'desktop.js', V + 'three.module.js', V + 'three.core.js'];
      ['pick', 'batch', 'quality', 'glide', 'camera-moves', 'stops', 'room-space', 'room-light', 'placeholder-room', 'objects/monitor-posts']
        .forEach(function (m) { code.push(S + m + '.js'); });
      ['controls/OrbitControls', 'loaders/GLTFLoader', 'loaders/DRACOLoader', 'utils/BufferGeometryUtils', 'utils/SkeletonUtils']
        .forEach(function (m) { code.push(A + m + '.js'); });
      if (innerWidth >= 768 && !matchMedia('(pointer: coarse)').matches) {
        ['postprocessing/EffectComposer', 'postprocessing/RenderPass', 'postprocessing/OutputPass', 'postprocessing/UnrealBloomPass',
          'postprocessing/ShaderPass', 'postprocessing/MaskPass', 'postprocessing/Pass', 'shaders/CopyShader', 'shaders/OutputShader',
          'shaders/LuminosityHighPassShader'].forEach(function (m) { code.push(A + m + '.js'); });
      }
      code.forEach(function (u) { add('modulepreload', u); });
      add('preload', '/content.json', 'fetch', true);
      add('preload', S + 'assets/dusk/room-light.json', 'fetch', true);
      add('preload', S + 'assets/dusk/lightmap.webp', 'image', true); // three.js loads textures with crossorigin=anonymous
      add('preload', S + 'assets/dusk/env.webp', 'image', true);
      add('preload', A + 'libs/draco/gltf/draco_wasm_wrapper.js', 'fetch', true);
      add('preload', A + 'libs/draco/gltf/draco_decoder.wasm', 'fetch', true);
      add('preload', S + 'assets/room.glb.gz', 'fetch', true);
    })();
  </script>
  <main id="main" class="wrap">
    <div id="static">
      <h1>{site.name}</h1>
      <p class="lede">{site.tagline}</p>
      <p>{site.intro}</p>

      <section class="section" aria-labelledby="h-projects">
        <div class="section-head">
          <h2 id="h-projects">Projects</h2>
          <a href="/projects" class="small">All projects</a>
        </div>
        {projects.length === 0 ? (
          <p class="empty">No projects yet.</p>
        ) : (
          <ul class="list">
            {projects.map((p) => (
              <li>
                <a class="item" href={`/projects/${p.id}`}>
                  <span class="item-title">{p.data.title}</span>
                  <span class="item-meta">{p.data.year}</span>
                  <span class="item-summary">{p.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="section" aria-labelledby="h-posts">
        <div class="section-head">
          <h2 id="h-posts">Posts</h2>
          <a href="/posts" class="small">All posts</a>
        </div>
        <div id="screen-slot" class="screen-slot"></div>
        {posts.length === 0 ? (
          <p class="empty">No posts yet.</p>
        ) : (
          <ul class="list">
            {posts.map((p) => (
              <li>
                <a class="item" href={`/posts/${p.id}`}>
                  <span class="item-title">{p.data.title}</span>
                  <time class="item-meta" datetime={isoDate(p.data.date)}>{formatDate(p.data.date)}</time>
                  <span class="item-summary">{p.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  </main>

  <!-- The room hook. See docs/02-architecture.md. boot.js starts the room only when the URL has ?room (Phase 3). -->
  <canvas id="room" hidden aria-hidden="true"></canvas>
  <script type="module" src="/scene/boot.js" is:inline></script>
</Base>
