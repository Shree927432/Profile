---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, isoDate } from '../../lib/content';

const posts = await getPosts();
---

<Base title="Posts" description="Notes and writing.">
  <main id="main" class="wrap">
    <h1>Posts</h1>
    {posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="list">
        {posts.map((p) => (
          <li>
            <a class="item" href={`/posts/${p.id}`}>
              <span class="item-title">{p.data.title}</span>
              <time class="item-meta" datetime={isoDate(p.data.date)}>{formatDate(p.data.date)}</time>
              <span class="item-summary">{p.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>
