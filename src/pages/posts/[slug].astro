---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, isoDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, summary, tags } = post.data;
---

<Base title={title} description={summary} type="article">
  <main id="main" class="wrap">
    <article>
      <header class="article-head">
        <h1>{title}</h1>
        <div class="meta">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          {tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {tags.map((t) => <li>{t}</li>)}
            </ul>
          )}
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
    <a class="back" href="/posts">← All posts</a>
  </main>
</Base>
